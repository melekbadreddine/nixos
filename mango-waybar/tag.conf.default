# Tag configuration
# Every tag (1-9) exists on every monitor.
# Customize layout per tag per monitor by editing below.
#
# Available layouts: tile, scroller, grid, deck, monocle, center_tile,
#                    vertical_tile, right_tile, vertical_scroller,
#                    vertical_grid, vertical_deck, tgmix
#
# Format: tagrule=id:<tag_id>,monitor_name:<regex>,layout_name:<layout>
#
# Tip: Leave this file empty for the default (scroller on all monitors).
# Uncomment and customize the examples below for your setup.

# ─── Example: All monitors use scroller layout ───
# tagrule=id:1,monitor_name:.*,layout_name:scroller
# tagrule=id:2,monitor_name:.*,layout_name:scroller
# tagrule=id:3,monitor_name:.*,layout_name:scroller
# tagrule=id:4,monitor_name:.*,layout_name:scroller
# tagrule=id:5,monitor_name:.*,layout_name:scroller
# tagrule=id:6,monitor_name:.*,layout_name:scroller
# tagrule=id:7,monitor_name:.*,layout_name:scroller
# tagrule=id:8,monitor_name:.*,layout_name:scroller
# tagrule=id:9,monitor_name:.*,layout_name:scroller

# ─── Example: Different layouts per monitor ───
# Primary monitor (DP-1): scroller for all tags
# tagrule=id:1,monitor_name:^DP-1$,layout_name:scroller
# tagrule=id:2,monitor_name:^DP-1$,layout_name:scroller
# ... (repeat for tags 3-9)
#
# Secondary monitor (HDMI-A-1): vertical_tile for all tags
# tagrule=id:1,monitor_name:^HDMI-A-1$,layout_name:vertical_tile
# tagrule=id:2,monitor_name:^HDMI-A-1$,layout_name:vertical_tile
# ... (repeat for tags 3-9)
