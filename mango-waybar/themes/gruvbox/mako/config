# Mako notification daemon - GruvboxAlt dark theme
# Matches Noctalia/Waybar styling

# ─── Appearance ───
font=JetBrainsMono Nerd Font 12
background-color=#1d2021dd
border-color=#504945
border-size=2
border-radius=12
padding=12
margin=8
width=360
height=200
max-icon-size=48
icon-path=/usr/share/icons/hicolor/48x48/apps:/usr/share/icons/hicolor/64x64/apps:/usr/share/icons/hicolor/128x128/apps

# ─── Text Colors ───
text-color=#ebdbb2

# ─── Progress Bar ───
progress-color=#b8bb26

# ─── Grouping ───
group-by=app-name
max-history=20

# ─── Behavior ───
default-timeout=5000
ignore-timeout=1
layer=overlay
anchor=top-right
outer-margin=8

# ─── Urgency Styling ───
[urgency=low]
border-color=#665c54

[urgency=high]
border-color=#fb4934
progress-color=#fb4934

# ─── Critical Notifications ───
[urgency=critical]
border-color=#cc241d
progress-color=#cc241d
default-timeout=0
