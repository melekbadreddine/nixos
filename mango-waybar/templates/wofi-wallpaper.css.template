/* ─── Wofi Wallpaper Grid Selector ─── */
/* Replicates BSPWM WallSelect.rasi style */
/* Generated from theme.conf via switch-theme.sh */

window {
    margin: 0px;
    padding: 0px;
    border: none;
    background-color: rgba(__BG_RGB__, 0.95);
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 0px;
}

#outer-box {
    margin: 0px;
    padding: 20px 30px;
    border: none;
    background-color: transparent;
}

#input {
    margin: 0px 0px 20px 0px;
    padding: 12px 20px;
    border: 2px solid rgba(__OUTLINE_RGB__, 0.8);
    border-radius: 12px;
    color: __FG__;
    background-color: rgba(__SURFACE_RGB__, 0.6);
    font-size: 16px;
}

#input:focus {
    background-color: rgba(__OUTLINE_RGB__, 0.8);
    border-color: __ACCENT__;
}

#scroll {
    margin: 0px;
    padding: 0px;
    border: none;
    background-color: transparent;
}

#inner-box {
    margin: 0px;
    padding: 0px;
    border: none;
    background-color: transparent;
}

#text {
    margin: 0px;
    padding: 0px;
    border: none;
    color: transparent;
    font-size: 0px;
}

#entry {
    padding: 6px;
    border-radius: 16px;
    background-color: transparent;
    border: 3px solid transparent;
}

#entry:selected {
    background-color: rgba(__ACCENT_RGB__, 0.3);
    border-color: __ACCENT__;
    border-radius: 16px;
}

#entry:hover {
    background-color: rgba(__OUTLINE_RGB__, 0.4);
    border-radius: 16px;
}

#entry img {
    border-radius: 12px;
}
