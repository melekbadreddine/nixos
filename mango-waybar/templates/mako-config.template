# Mako notification daemon
# Generated from theme.conf via switch-theme.sh

# ─── Appearance ───
font=JetBrainsMono Nerd Font 12
background-color=__BG__dd
border-color=__OUTLINE__
border-size=2
border-radius=12
padding=12
margin=8
width=360
height=200
max-icon-size=48
icon-path=/usr/share/icons/hicolor/48x48/apps:/usr/share/icons/hicolor/64x64/apps:/usr/share/icons/hicolor/128x128/apps

# ─── Text Colors ───
text-color=__FG__

# ─── Progress Bar ───
progress-color=__ACCENT__

# ─── Grouping ───
group-by=app-name
max-history=20

# ─── Behavior ───
default-timeout=5000
ignore-timeout=1
layer=overlay
anchor=top-right
outer-margin=8

# ─── Urgency Styling ───
[urgency=low]
border-color=__BLACKB__

[urgency=high]
border-color=__ERROR__
progress-color=__ERROR__

# ─── Critical Notifications ───
[urgency=critical]
border-color=__RED__
progress-color=__RED__
default-timeout=0
