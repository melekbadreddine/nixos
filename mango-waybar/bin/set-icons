#!/bin/bash

# set-icons - Quickly switch Tela icon theme colors
# Usage: set-icons --<color>
# Example: set-icons --pink, set-icons --blue, set-icons --nord

set -e

# Available colors and their Tela variants
# Format: "command_flag|icon_theme_name"
COLORS=(
    "black|Tela-black-dark"
    "blue|Tela-blue-dark"
    "brown|Tela-brown-dark"
    "green|Tela-green-dark"
    "grey|Tela-grey-dark"
    "orange|Tela-orange-dark"
    "pink|Tela-pink-dark"
    "purple|Tela-purple-dark"
    "red|Tela-red-dark"
    "yellow|Tela-yellow-dark"
    "manjaro|Tela-manjaro-dark"
    "ubuntu|Tela-ubuntu-dark"
    "dracula|Tela-dracula-dark"
    "nord|Tela-nord-dark"
    "standard|Tela-dark"
)

# Show usage
show_usage() {
    echo "Usage: set-icons --<color>"
    echo ""
    echo "Available colors:"
    for color_info in "${COLORS[@]}"; do
        flag="${color_info%%|*}"
        echo "  --${flag}"
    done
    echo ""
    echo "Example: set-icons --pink"
    exit 1
}

# Parse arguments
if [ $# -eq 0 ]; then
    # No argument provided: use fzf to select variant
    if ! command -v fzf &> /dev/null; then
        echo "Error: fzf is not installed. Please install fzf or provide a variant with --<color>"
        show_usage
    fi

    # Build list for fzf (show flag and theme name)
    FZF_LIST=()
    for color_info in "${COLORS[@]}"; do
        flag="${color_info%%|*}"
        theme="${color_info##*|}"
        FZF_LIST+=("${flag} (${theme})")
    done

    # Run fzf
    SELECTED=$(printf '%s\n' "${FZF_LIST[@]}" | fzf --prompt="Select icon variant: " --height=15 --reverse)

    if [ -z "$SELECTED" ]; then
        echo "No variant selected. Exiting."
        exit 0
    fi

    # Extract flag from selection (everything before the first space)
    COLOR_INPUT="${SELECTED%% *}"
else
    # Extract color from argument (remove -- prefix)
    ARG="$1"
    if [[ ! "$ARG" =~ ^-- ]]; then
        echo "Error: Argument must start with --"
        show_usage
    fi

    COLOR_INPUT="${ARG#--}"
fi

# Find matching icon theme
ICON_THEME=""
for color_info in "${COLORS[@]}"; do
    flag="${color_info%%|*}"
    theme="${color_info##*|}"
    if [ "$COLOR_INPUT" = "$flag" ]; then
        ICON_THEME="$theme"
        break
    fi
done

if [ -z "$ICON_THEME" ]; then
    echo "Error: Unknown color '$COLOR_INPUT'"
    show_usage
fi

echo "🎨 Setting icon theme to: $ICON_THEME"

# Update gsettings (GTK)
if command -v gsettings &> /dev/null; then
    echo "  → Updating gsettings..."
    gsettings set org.gnome.desktop.interface icon-theme "$ICON_THEME"
fi

# Update GTK 3.0 settings
if [ -f "$HOME/.config/gtk-3.0/settings.ini" ]; then
    echo "  → Updating GTK 3.0 config..."
    sed -i "s/^gtk-icon-theme-name=.*/gtk-icon-theme-name=$ICON_THEME/" "$HOME/.config/gtk-3.0/settings.ini"
fi

# Update GTK 4.0 settings
if [ -f "$HOME/.config/gtk-4.0/settings.ini" ]; then
    echo "  → Updating GTK 4.0 config..."
    sed -i "s/^gtk-icon-theme-name=.*/gtk-icon-theme-name=$ICON_THEME/" "$HOME/.config/gtk-4.0/settings.ini"
fi

# Update QT6 settings
if [ -f "$HOME/.config/qt6ct/qt6ct.conf" ]; then
    echo "  → Updating QT6 config..."
    sed -i "s/^icon_theme=.*/icon_theme=$ICON_THEME/" "$HOME/.config/qt6ct/qt6ct.conf"
fi

# Update QT5 settings (if exists)
if [ -f "$HOME/.config/qt5ct/qt5ct.conf" ]; then
    echo "  → Updating QT5 config..."
    sed -i "s/^icon_theme=.*/icon_theme=$ICON_THEME/" "$HOME/.config/qt5ct/qt5ct.conf"
fi

# Restart noctalia-shell
echo "  → Restarting noctalia-shell..."
if pgrep -f "qs.*noctalia-shell" > /dev/null; then
    # Kill existing noctalia-shell
    pkill -f "qs.*noctalia-shell" || true
    # Wait for it to fully exit
    sleep 0.5
fi

# Start noctalia-shell
qs -c noctalia-shell &

echo ""
echo "✅ Icon theme set to $ICON_THEME and noctalia-shell restarted!"
