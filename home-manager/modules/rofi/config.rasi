@import "colors.rasi"

* {
  background-color: var(transparent);
  text-color: var(fg0);
  font: "JetBrainsMono Nerd Font 12";
}

window {
  transparency: "real";
  location: center;
  anchor: center;
  fullscreen: false;
  width: 600px;
  border-radius: 16px;
  border: 2px solid;
  border-color: var(accent);
  background-color: var(bg0);
}

mainbox {
  background-color: var(transparent);
  children: [inputbar, message, listview, mode-switcher];
  spacing: 0;
  padding: 12px;
}

inputbar {
  background-color: var(bg1);
  border-radius: 12px;
  padding: 10px 14px;
  spacing: 10px;
  children: [prompt, textbox-prompt-colon, entry];
  margin: 0 0 10px 0;
}

prompt {
  background-color: var(transparent);
  text-color: var(accent);
  font: "JetBrainsMono Nerd Font Bold 13";
}

textbox-prompt-colon {
  background-color: var(transparent);
  text-color: var(fg1);
  str: "";
  expand: false;
}

entry {
  background-color: var(transparent);
  text-color: var(fg0);
  placeholder-color: var(fg1);
  placeholder: "Search…";
  cursor: text;
}

listview {
  background-color: var(transparent);
  columns: 1;
  lines: 8;
  cycle: true;
  dynamic: true;
  layout: vertical;
  spacing: 4px;
  scrollbar: false;
}

element {
  background-color: var(transparent);
  border-radius: 10px;
  padding: 8px 12px;
  spacing: 10px;
  orientation: horizontal;
  children: [element-icon, element-text];
}

element.selected.normal {
  background-color: var(bg2);
  text-color: var(fg0);
}

element.urgent {
  text-color: var(urgent);
}

element.active {
  text-color: var(accent);
}

element-icon {
  background-color: var(transparent);
  size: 24px;
}

element-text {
  background-color: var(transparent);
  text-color: inherit;
  highlight: bold var(accent);
  vertical-align: 0.5;
}

mode-switcher {
  background-color: var(bg1);
  border-radius: 12px;
  padding: 6px;
  spacing: 6px;
  margin: 10px 0 0 0;
}

button {
  background-color: var(transparent);
  text-color: var(fg1);
  border-radius: 8px;
  padding: 4px 12px;
  cursor: pointer;
}

button.selected {
  background-color: var(accent);
  text-color: var(bg0);
}

message {
  background-color: var(transparent);
  padding: 0 0 8px 0;
}

textbox {
  background-color: var(bg1);
  border-radius: 8px;
  padding: 8px 12px;
  text-color: var(fg1);
}
